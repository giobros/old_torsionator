Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu20.04

%labels
    Maintainer  gbrosio@iit.local
    Version     2.1.0
    Description torsionator — MACE + PyTorch 2.4.1+cu118 + TF 2.14 + AmberTools 22 + CUDA 11.8

%environment
    export PATH=/opt/conda/envs/obiwan_env/bin:/opt/conda/bin:$PATH
    export CONDA_DEFAULT_ENV=obiwan_env
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda-11.8/lib64:${LD_LIBRARY_PATH:-}
    export OBI_ROOT=/app/OBIWAN
    export OBIWAN_MODEL_PATH=${OBI_ROOT}/results/models
    export PYTHONPATH=/
    export TF_CPP_MIN_LOG_LEVEL=2
    export PYTHONUNBUFFERED=1

%files
    # Run: apptainer build torsionator.sif torsionator.def  (from the container/ directory)
    obi.py /opt/obi_custom/obi.py
    ../torsionator /torsionator

%post -c /bin/bash
    set -euxo pipefail
    export DEBIAN_FRONTEND=noninteractive
    export PATH=/opt/conda/envs/obiwan_env/bin:/opt/conda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda-11.8/lib64:${LD_LIBRARY_PATH:-}

    # 1) System deps
    apt-get update -qq
    apt-get install -y --no-install-recommends \
        wget curl git build-essential ca-certificates libgl1 libglib2.0-0
    rm -rf /var/lib/apt/lists/*

    # 2) Miniconda (pinned installer, Python 3.9)
    MINICONDA_VERSION="Miniconda3-py39_24.11.1-0-Linux-x86_64.sh"
    wget -q -O /tmp/miniconda.sh \
        "https://repo.anaconda.com/miniconda/${MINICONDA_VERSION}"
    bash /tmp/miniconda.sh -b -p /opt/conda
    rm /tmp/miniconda.sh
    /opt/conda/bin/conda config --system --remove channels defaults 2>/dev/null || true
    /opt/conda/bin/conda config --system --add channels conda-forge
    /opt/conda/bin/conda config --system --set channel_priority flexible
    /opt/conda/bin/conda install -y -n base -c conda-forge mamba

    # 3) Python 3.9 env
    /opt/conda/bin/mamba create -y -n obiwan_env -c conda-forge \
        "python=3.9.23"

    # 4) AmberTools 22 (cpptraj, antechamber, tleap, pdb4amber, sander)
    /opt/conda/bin/mamba install -y -n obiwan_env -c conda-forge \
        "ambertools=22"

    # 5) OpenBabel
    /opt/conda/bin/mamba install -y -n obiwan_env -c conda-forge \
        openbabel

    # 6) RDKit + ASE (conda to avoid binary incompatibilities)
    /opt/conda/bin/mamba install -y -n obiwan_env -c conda-forge \
        "rdkit=2023.03.3" \
        "ase=3.23.0"

    # 7) TF 2.14 + pinned scientific stack (numpy 1.23.5 required by TF 2.14)
    /opt/conda/bin/mamba run -n obiwan_env pip install --no-cache-dir \
        "tensorflow==2.14.0" \
        "numpy==1.23.5" \
        "Pillow==10.4.0" \
        "matplotlib==3.9.4" \
        "scipy==1.13.1" \
        "pandas==2.0.3" \
        "h5py==3.11.0" \
        "tqdm==4.67.1" \
        "joblib==1.5.1" \
        "networkx==3.2.1"

    # 8) PyTorch 2.4.1 + CUDA 11.8 wheels
    /opt/conda/bin/mamba run -n obiwan_env pip install --no-cache-dir \
        "torch==2.4.1+cu118" \
        "torchvision==0.19.1+cu118" \
        "torchaudio==2.4.1+cu118" \
        --index-url https://download.pytorch.org/whl/cu118

    # 9) MACE-torch 0.3.14 + related (matches vecchio.sif, known working)
    /opt/conda/bin/mamba run -n obiwan_env pip install --no-cache-dir \
        "mace-torch==0.3.14" \
        "e3nn==0.4.4" \
        "torch-ema==0.3" \
        "torchmetrics==1.8.2"

    # 10) Extras used by torsionator
    /opt/conda/bin/mamba run -n obiwan_env pip install --no-cache-dir \
        "ParmEd==4.0.0"

    # 11) Force numpy back to 1.x — mace-torch pulls numpy 2.x which breaks TF 2.14
    /opt/conda/bin/mamba run -n obiwan_env pip install --no-cache-dir \
        --force-reinstall "numpy==1.26.4"

    # 12) Custom ASE/OBIWAN calculator (baked in; prova.sh may override at runtime)
    mkdir -p /opt/conda/envs/obiwan_env/lib/python3.9/site-packages/ase/calculators
    cp -f /opt/obi_custom/obi.py \
        /opt/conda/envs/obiwan_env/lib/python3.9/site-packages/ase/calculators/obi.py

    # 13) Clone OBIWAN into the container so 'architectures' is always importable
    #     (prova.sh bind /tmp/OBIWAN:/app/OBIWAN will override at runtime if it exists)
    git clone https://github.com/virtualmartire/OBIWAN.git /app/OBIWAN

    # 14) Mount-points + cleanup
    mkdir -p /workspace /data
    /opt/conda/bin/conda clean -afy 2>/dev/null || true
    /opt/conda/bin/mamba run -n obiwan_env pip cache purge 2>/dev/null || true

%test
    export PATH=/opt/conda/envs/obiwan_env/bin:/opt/conda/bin:$PATH
    export PYTHONPATH=/
    python -c "
import numpy as np, torch, tensorflow as tf
import rdkit, ase, mace
import pandas, scipy, matplotlib, networkx, tqdm, joblib
print('numpy      :', np.__version__)
print('torch      :', torch.__version__)
print('tf         :', tf.__version__)
print('rdkit      :', rdkit.__version__)
print('ase        :', ase.__version__)
print('mace       :', mace.__version__)
"
    python -c "
import torch, tensorflow as tf
print('PyTorch CUDA:', torch.cuda.is_available())
print('TF GPUs     :', tf.config.list_physical_devices('GPU'))
"
    python -c "import torsionator.cli; print('torsionator.cli OK')"
    cpptraj --version
    antechamber -h 2>&1 | head -2
    echo '=== BUILD TEST PASSED ==='

%runscript
    export PATH=/opt/conda/envs/obiwan_env/bin:/opt/conda/bin:$PATH
    cd /workspace
    exec "$@"

%help
    BUILD  (run from the 2_cont/ directory):
      apptainer build --fakeroot torsionator.sif torsionator.def
      sudo apptainer build torsionator.sif torsionator.def

    TEST (after build):
      apptainer test --nv torsionator.sif

    Versions:
      CUDA        11.8
      Python      3.9.23
      AmberTools  22
      PyTorch     2.4.1+cu118
      TensorFlow  2.14.0
      MACE-torch  0.3.10
      RDKit       2023.03.3
      ASE         3.23.0
      numpy       1.23.5
